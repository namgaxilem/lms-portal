# ─────────────────────────── Moodle connection ───────────────────────────
# All variables are read at runtime: one build can be deployed for any school.

# Base URL of your Moodle site as the portal server reaches it (no trailing slash).
MOODLE_URL=https://moodle.example.com

# Optional: Moodle's public URL (its wwwroot) when it differs from MOODLE_URL,
# e.g. when the server talks to Moodle over an internal Docker hostname.
# Used for deep links and to recognise Moodle file URLs. Defaults to MOODLE_URL.
MOODLE_PUBLIC_URL=

# Web service short name. Must be enabled in Moodle:
# Site administration > Server > Web services > External services.
# The built-in "Moodle mobile web service" uses this short name.
MOODLE_SERVICE=moodle_mobile_app

# Dev only: set to 1 to trust a self-signed TLS cert (e.g. https://localhost).
# Leave unset / 0 in production.
MOODLE_INSECURE_TLS=0

# Optional: token of a dedicated Moodle web service used ONLY to read grading
# metadata the mobile service does not expose (rubric / marking guide
# definitions and fillings, scale items). Create an external service with just
# core_grading_get_definitions, core_grading_get_gradingform_instances and
# core_course_get_course_module, and a token for a manager-role service user.
# Without it, the grading screen supports simple points grading only.
MOODLE_GRADING_TOKEN=

# Max size (MB) of a single file uploaded through the portal (assignment submissions).
MOODLE_MAX_UPLOAD_MB=50

# ─────────────────────────── School branding ───────────────────────────
# Every BRAND_* variable is optional; unset ones fall back to the defaults in
# src/config/brand.ts. Colours must be hex (#rgb or #rrggbb) IN QUOTES — an
# unquoted # starts a comment in .env files, e.g. BRAND_COLOR_PRIMARY="#0e5b63".
# Logo/favicon accept a path under public/ (e.g. /images/logo-mark.png) or an
# https:// URL. The sidebar / phone top bar colour is derived from the primary.
# See CONFIG_GUIDE.md.

BRAND_NAME=
BRAND_SHORT_NAME=
BRAND_APP_NAME=
BRAND_DESCRIPTION=
BRAND_TAGLINE=
BRAND_URL=
BRAND_LOGO_MARK=
BRAND_FAVICON=

# Main colour (buttons, links) and the two extra stops of the hero gradient.
BRAND_COLOR_PRIMARY=
BRAND_COLOR_SECONDARY=
BRAND_COLOR_ACCENT=
# Optional lighter primary for dark mode (derived from the primary when unset).
BRAND_COLOR_PRIMARY_DARK=
BRAND_COLOR_SUCCESS=
BRAND_COLOR_WARNING=
BRAND_COLOR_ERROR=

# Contact details shown on the landing and login pages (hidden when empty).
BRAND_SUPPORT_EMAIL=
BRAND_SUPPORT_PHONE=
BRAND_SUPPORT_ADDRESS=
